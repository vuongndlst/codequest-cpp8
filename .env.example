# ============================================================================
# CODEQUEST C++ 8 — Biến môi trường
#
# Cách dùng:
#   1. Sao chép file này thành `.env`  (Windows: copy .env.example .env)
#   2. Điền giá trị lấy từ Supabase Dashboard
#   3. Khởi động lại `npm run dev`
#
# ⚠ TUYỆT ĐỐI KHÔNG commit file `.env` thật lên GitHub.
# ⚠ TUYỆT ĐỐI KHÔNG đặt service_role key vào đây — mọi biến VITE_* đều được
#   nhúng thẳng vào file JavaScript công khai mà ai cũng đọc được.
#   Bảo vệ dữ liệu thật sự nằm ở Row Level Security trong database.
# ============================================================================

# Supabase Dashboard -> Project Settings -> Data API -> Project URL
VITE_SUPABASE_URL=

# Supabase Dashboard -> Project Settings -> API Keys -> Publishable key
# (dự án cũ hơn có thể hiển thị tên là "anon public key" — dùng khoá đó)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Tuỳ chọn: ghi đè base path khi build.
# · Repo dạng project  (username.github.io/codequest-cpp8) -> /codequest-cpp8/
# · Repo dạng username.github.io                            -> /
# Để trống thì GitHub Actions tự suy ra từ tên repository.
# VITE_BASE_PATH=
